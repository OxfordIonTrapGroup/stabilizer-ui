      <item>
       <layout class="QHBoxLayout" name="lockModeLayout">
        <item>
         <widget class="QRadioButton" name="disablePztButton">
          <property name="toolTip">
           <string>Zero coefficients for the first filter of both channels: both DAC outputs are zero.</string>
          </property>
          <property name="text">
           <string>Disable (zero output)</string>
          </property>
