           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QRadioButton" name="rampPztButton">
          <property name="toolTip">
           <string>Pass ADC0 through to the fast PZT with a gain of 5 (about ±10 V from the Vescent servo box ramp), with the slow PZT output zero, for finding the resonance.</string>
          </property>
          <property name="text">
           <string>Pass through (ramp)</string>
          </property>
          <property name="shortcut">
           <string>F7</string>
          </property>
         </widget>
        </item>
